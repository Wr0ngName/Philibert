{
  "name": "philibert",
  "productName": "Philibert",
  "version": "0.31.0-rc.2",
  "description": "Desktop GUI for Claude Code - AI-powered coding assistant for non-technical users",
  "main": ".vite/build/index.cjs",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://dev.web.wr0ng.name/wrongname/philibert.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint src/ forge.config.ts",
    "lint:fix": "eslint src/ forge.config.ts --fix",
    "typecheck": "vue-tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "test": "vitest run",
    "pretest:browser": "playwright install --only-shell chromium",
    "test:browser": "vitest run --config vitest.browser.config.mts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,css,json}\"",
    "build:channel-server": "esbuild src/main/services/channel/channel-server.ts --bundle --platform=node --format=cjs --outfile=out/channel-server.cjs",
    "prepare": "husky",
    "fetch:whisper": "bash scripts/fetch-whisper.sh"
  },
  "keywords": [
    "electron",
    "claude",
    "ai",
    "coding-assistant",
    "gui",
    "vue"
  ],
  "author": {
    "name": "wrongname"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/dompurify": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/browser-playwright": "4.1.12",
    "@vue/test-utils": "^2.4.10",
    "electron": "42.11.18",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.2.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.2.8"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@anthropic-ai/claude-code": "2.1.280",
    "@anthropic-ai/sdk": "0.95.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/typography": "^0.5.19",
    "dompurify": "^3.4.2",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "marked": "^18.0.3",
    "node-pty": "^1.1.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.45"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.6"
    },
    "brace-expansion@1": "1.1.22",
    "@xmldom/xmldom@0.9": "0.9.12"
  }
}
