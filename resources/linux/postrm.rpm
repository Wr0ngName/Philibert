#!/bin/bash
# Post-removal script for Philibert (RPM)

APP_NAME="Philibert"

if [ "$1" = "0" ]; then
    # Package is being removed (not upgraded)

    # The updater's marker (see postinst.rpm) is not one of the package's
    # files, so rpm leaves it, and the folders holding it, behind.
    rm -f /usr/lib/philibert/resources/package-type
    rmdir --ignore-fail-on-non-empty /usr/lib/philibert/resources /usr/lib/philibert 2>/dev/null || true

    echo ""
    echo "Philibert has been removed."
    echo ""
    echo "Your configuration and conversation history have been preserved in:"
    echo "  ~/.config/$APP_NAME/"
    echo ""
    echo "To completely remove all data, run:"
    echo "  rm -rf ~/.config/$APP_NAME/ ~/.config/ClineGUI/ ~/.config/Cline\ GUI/ ~/.config/cline-gui/"
    echo ""
fi

exit 0
